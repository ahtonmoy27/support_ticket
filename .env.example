APP_NAME="Support Ticket & SLA"

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Empty values skip administrator creation; no default credentials exist.
# Set both explicitly before seeding; password must contain at least 12 characters.
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_PASSWORD=

TICKET_AUTO_ASSIGN=true
TICKET_ATTACHMENT_DISK=private
TICKET_IMPORT_MAX_ROWS=100000

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=support_ticket_sla
DB_USERNAME=support_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcasting (real-time WebSocket) ──────────────────────────────────────
# Options: reverb | pusher | log  (log = disabled, development only)
BROADCAST_CONNECTION=log

# Reverb — self-hosted, zero external dependency
#   1. Install:  composer require laravel/reverb
#   2. Publish:  php artisan reverb:install
#   3. Start:    php artisan reverb:start
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=support
REVERB_APP_KEY=support-key
REVERB_APP_SECRET=support-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Pusher — cloud alternative (sign up free at https://pusher.com)
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=mt1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Options: log (no email, dev) | smtp | mailgun | ses | postmark | resend
# Local testing → Mailtrap (https://mailtrap.io → Email Testing → SMTP credentials)
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<mailtrap-user>
# MAIL_PASSWORD=<mailtrap-pass>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TICKET_IMPORT_STALE_SECONDS=1800
SUPPORT_OUTBOX_MAX_AGE_SECONDS=300
SUPPORT_HEARTBEAT_MAX_AGE_SECONDS=300
SUPPORT_QUEUE_MAX_JOBS=1000
SUPPORT_QUEUE_MAX_AGE_SECONDS=300
SUPPORT_ALERT_COOLDOWN_SECONDS=300
